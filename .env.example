# Ausschließlich synthetische Daten. Echte Daten sind in dieser Version gesperrt.
TAXIDTA_MODE=demo
HOST=127.0.0.1
PORT=3000
# Ohne Projektkonfiguration bleibt die lokale Demo ohne Anmeldung erreichbar.
# Für die Inhaber-Anmeldung die bestätigten Werte privat in .env.local setzen.
TAXIDTA_AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_OWNER_ID=
TAXIDTA_OWNER_IK=
# „europe“ allein bestätigt keinen Standort. Erst nach Verwaltungsprüfung setzen.
SUPABASE_REPORTED_REGION=
SUPABASE_CONFIRMED_REGION=
SUPABASE_REGION_VERIFIED_AT=
